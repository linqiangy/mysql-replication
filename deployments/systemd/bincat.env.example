# systemd EnvironmentFile，不是 shell 脚本；必须替换全部占位值。
BINCAT_META_DSN="bincat_meta_user:REPLACE_PASSWORD@tcp(127.0.0.1:3306)/bincat_meta?parseTime=true&charset=utf8mb4"
BINCAT_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
# 用 openssl rand -base64 32 生成，粘贴输出，不要填写命令本身。
BINCAT_SECRET_KEY=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
# 用 openssl rand -hex 32 生成。
BINCAT_JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET
